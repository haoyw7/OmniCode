{
  "description": "Shared checkout_resources rules. host/checkout-guards.test.ts and src-tauri/src/local_host.rs both replay every case: given existing rows, may a new claim of `request.kind` on `request.path` be taken? Paths are relative to a temporary root and need not exist. Owner `live` is the test process; `dead` is pid 0.",
  "cases": [
    {"name": "resource ignores an overlapping resource", "rows": [{"path": "repo", "kind": "resource", "owner": "live"}], "request": {"path": "repo", "kind": "resource"}, "allowed": true},
    {"name": "resource ignores an overlapping write", "rows": [{"path": "repo", "kind": "writing", "owner": "live"}], "request": {"path": "repo", "kind": "resource"}, "allowed": true},
    {"name": "resource ignores an overlapping integration", "rows": [{"path": "repo", "kind": "integrating", "owner": "live"}], "request": {"path": "repo", "kind": "resource"}, "allowed": true},
    {"name": "resource waits for an overlapping removal", "rows": [{"path": "repo", "kind": "removing", "owner": "live"}], "request": {"path": "repo", "kind": "resource"}, "allowed": false},
    {"name": "write ignores an overlapping resource", "rows": [{"path": "repo", "kind": "resource", "owner": "live"}], "request": {"path": "repo", "kind": "writing"}, "allowed": true},
    {"name": "write ignores another overlapping write", "rows": [{"path": "repo", "kind": "writing", "owner": "live"}], "request": {"path": "repo", "kind": "writing"}, "allowed": true},
    {"name": "write waits for an overlapping integration", "rows": [{"path": "repo", "kind": "integrating", "owner": "live"}], "request": {"path": "repo", "kind": "writing"}, "allowed": false},
    {"name": "write waits for an overlapping removal", "rows": [{"path": "repo", "kind": "removing", "owner": "live"}], "request": {"path": "repo", "kind": "writing"}, "allowed": false},
    {"name": "integration ignores an overlapping resource", "rows": [{"path": "repo", "kind": "resource", "owner": "live"}], "request": {"path": "repo", "kind": "integrating"}, "allowed": true},
    {"name": "integration waits for an overlapping write", "rows": [{"path": "repo", "kind": "writing", "owner": "live"}], "request": {"path": "repo", "kind": "integrating"}, "allowed": false},
    {"name": "integration waits for another overlapping integration", "rows": [{"path": "repo", "kind": "integrating", "owner": "live"}], "request": {"path": "repo", "kind": "integrating"}, "allowed": false},
    {"name": "integration waits for an overlapping removal", "rows": [{"path": "repo", "kind": "removing", "owner": "live"}], "request": {"path": "repo", "kind": "integrating"}, "allowed": false},
    {"name": "removal waits for an overlapping resource", "rows": [{"path": "repo", "kind": "resource", "owner": "live"}], "request": {"path": "repo", "kind": "removing"}, "allowed": false},
    {"name": "removal waits for an overlapping write", "rows": [{"path": "repo", "kind": "writing", "owner": "live"}], "request": {"path": "repo", "kind": "removing"}, "allowed": false},
    {"name": "removal waits for an overlapping integration", "rows": [{"path": "repo", "kind": "integrating", "owner": "live"}], "request": {"path": "repo", "kind": "removing"}, "allowed": false},
    {"name": "removal waits for another overlapping removal", "rows": [{"path": "repo", "kind": "removing", "owner": "live"}], "request": {"path": "repo", "kind": "removing"}, "allowed": false},
    {"name": "a nested request overlaps its parent", "rows": [{"path": "repo", "kind": "removing", "owner": "live"}], "request": {"path": "repo/src/main.ts", "kind": "resource"}, "allowed": false},
    {"name": "a parent request overlaps a nested row", "rows": [{"path": "repo/src/main.ts", "kind": "resource", "owner": "live"}], "request": {"path": "repo", "kind": "removing"}, "allowed": false},
    {"name": "a shared name prefix is not an overlap", "rows": [{"path": "repo", "kind": "removing", "owner": "live"}], "request": {"path": "repo-2", "kind": "resource"}, "allowed": true},
    {"name": "a trailing slash names the same path", "rows": [{"path": "repo", "kind": "removing", "owner": "live"}], "request": {"path": "repo/", "kind": "resource"}, "allowed": false},
    {"name": "a dead owner's row is recovered", "rows": [{"path": "repo", "kind": "removing", "owner": "dead"}], "request": {"path": "repo", "kind": "resource"}, "allowed": true},
    {"name": "only overlapping rows matter", "rows": [{"path": "other", "kind": "removing", "owner": "live"}, {"path": "repo", "kind": "resource", "owner": "live"}], "request": {"path": "repo", "kind": "integrating"}, "allowed": true},
    {"name": "resource shares with executing", "rows": [{"path": "repo", "kind": "executing", "owner": "live"}], "request": {"path": "repo", "kind": "resource"}, "allowed": true},
    {"name": "writing shares with executing", "rows": [{"path": "repo", "kind": "executing", "owner": "live"}], "request": {"path": "repo", "kind": "writing"}, "allowed": true},
    {"name": "executing shares with resource", "rows": [{"path": "repo", "kind": "resource", "owner": "live"}], "request": {"path": "repo", "kind": "executing"}, "allowed": true},
    {"name": "executing shares with writing", "rows": [{"path": "repo", "kind": "writing", "owner": "live"}], "request": {"path": "repo", "kind": "executing"}, "allowed": true},
    {"name": "executing shares with executing", "rows": [{"path": "repo", "kind": "executing", "owner": "live"}], "request": {"path": "repo", "kind": "executing"}, "allowed": true},
    {"name": "executing waits for integrating", "rows": [{"path": "repo", "kind": "integrating", "owner": "live"}], "request": {"path": "repo", "kind": "executing"}, "allowed": false},
    {"name": "executing waits for removing", "rows": [{"path": "repo", "kind": "removing", "owner": "live"}], "request": {"path": "repo", "kind": "executing"}, "allowed": false},
    {"name": "integrating waits for executing", "rows": [{"path": "repo", "kind": "executing", "owner": "live"}], "request": {"path": "repo", "kind": "integrating"}, "allowed": false},
    {"name": "removing waits for executing", "rows": [{"path": "repo", "kind": "executing", "owner": "live"}], "request": {"path": "repo", "kind": "removing"}, "allowed": false}
  ]
}
