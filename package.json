{
  "name": "omnicode-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node src/integrations/workflow/generate-libs.mjs && vite",
    "postinstall": "npm ci --prefix host/im --no-audit --no-fund && node src/integrations/workflow/generate-libs.mjs",
    "dev:stable": "vite --mode stable",
    "dev:refresh": "bash scripts/dev-refresh.sh",
    "build": "node src/integrations/workflow/generate-libs.mjs && tsc && vite build",
    "preview": "vite preview",
    "test": "node src/integrations/workflow/generate-libs.mjs && vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "host:build": "node src/integrations/workflow/generate-libs.mjs && tsc --noEmit -p host/tsconfig.json && node host/build.mjs",
    "host:package": "npm run host:build && node host/package.mjs",
    "host:desktop-package": "npm run host:build && node host/package.mjs --desktop",
    "host:wsl-runtime": "node host/package.mjs --wsl-runtime",
    "host": "node build/host/omnicode-host.mjs",
    "pretest:host": "npm run host:build",
    "test:host": "vitest run --config host/vitest.config.ts",
    "check": "npm run check:web && npm run check:rust",
    "check:web": "node src/integrations/workflow/generate-libs.mjs && npm run check:arch && vitest run && tsc --noEmit",
    "check:arch": "node scripts/arch-baseline.mjs",
    "check:rust": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test",
    "set-version": "node scripts/bump-version.mjs",
    "tauri": "tauri",
    "tauri:stable": "tauri dev --no-watch --config src-tauri/tauri.stable.conf.json",
    "setup:linux:deb": "bash scripts/install-linux-deps-debian.sh",
    "setup:linux:fedora": "bash scripts/install-linux-deps-fedora.sh",
    "build:linux": "tauri build --bundles deb,appimage",
    "build:linux:release": "tauri build --bundles deb,appimage --config src-tauri/tauri.release.conf.json",
    "desktop:publish": "bash scripts/desktop-task-publish.sh",
    "test:desktop-publish": "node --test scripts/desktop-task-publish.test.mjs scripts/publish-desktop-update.test.mjs scripts/desktop-windows-build.test.mjs",
    "build:fedora": "tauri build --bundles rpm",
    "build:windows": "set \"RUSTUP_TOOLCHAIN=stable-x86_64-pc-windows-msvc\" && tauri build --bundles nsis",
    "build:windows:release": "npm run build:windows -- --config src-tauri/tauri.release.conf.json",
    "mobile:dev": "vite --config vite.mobile.config.ts",
    "mobile:build": "node src/integrations/workflow/generate-libs.mjs && tsc --noEmit && tsc -p tsconfig.mobile-tools.json && vite build --config vite.mobile.config.ts",
    "mobile:sync": "npm run mobile:build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:apk": "npm run mobile:sync && mobile/android/gradlew -p mobile/android :app:assembleDebug",
    "mobile:apk:release": "npm run mobile:build -- --mode release && cap sync android && mobile/android/gradlew -p mobile/android :app:assembleRelease",
    "mobile:publish": "bash mobile/task-publish.sh",
    "mobile:updates": "node mobile/update-server.mjs",
    "test:mobile-publish": "node --test mobile/task-publish.test.mjs",
    "test:mobile-updates": "node --test mobile/update-server.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/status-bar": "^8.0.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.5.11",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.2",
    "@lezer/highlight": "^1.2.3",
    "@pierre/diffs": "1.1.22",
    "@pierre/theme": "0.0.28",
    "@streamdown/code": "^1.1.1",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "3.13.23",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "cuelume": "^0.2.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.1.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "prettier": "^3.9.6",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.90.0",
    "react-material-icon-theme": "^1.2.0",
    "react-resizable-panels": "^4.14.7",
    "recharts": "^3.10.1",
    "rehype-harden": "^1.1.8",
    "remend": "^1.3.0",
    "shiki": "^3.23.0",
    "smol-toml": "^1.9.1",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "26.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
